{
  "name": "recallify",
  "version": "1.0.0",
  "description": "Recallify — AI-Powered Interactive Study Assistant",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "npm --prefix server run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build && npm --prefix server install",
    "start": "node server/server.js",
    "test": "node test-validation.js",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
